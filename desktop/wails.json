{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "nova-studio",
  "outputfilename": "Nova Studio",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "http://localhost:5173",
  "author": {
    "name": "tanlian"
  },
  "info": {
    "companyName": "Nova",
    "productName": "Nova Studio",
    "productVersion": "0.1.0",
    "copyright": "Copyright ........",
    "comments": "AI 网文创作工作室"
  },
  "wailsjsdir": "./frontend/src/wailsjs",
  "version": "2",
  "outputType": "desktop",
  "runNonNativeBuildHooks": false,
  "debounceMS": 100,
  "devMode": "dev",
  "appdir": ".",
  "assetdir": "frontend/dist",
  "reloaddirs": "frontend/dist"
}
